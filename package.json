{
  "name": "askvid",
  "version": "0.1.3",
  "description": "Ask questions about local, remote, and YouTube videos from the command line.",
  "keywords": [
    "ai",
    "cli",
    "openrouter",
    "video",
    "youtube"
  ],
  "homepage": "https://github.com/kynnyhsap/askvid#readme",
  "bugs": {
    "url": "https://github.com/kynnyhsap/askvid/issues"
  },
  "license": "MIT",
  "author": "kynnyhsap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kynnyhsap/askvid.git"
  },
  "bin": {
    "askvid": "dist/askvid.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "askvid": "bun run src/main.ts",
    "cli": "bun run src/main.ts",
    "build": "bun build ./src/main.ts --target=node --format=esm --packages=bundle --sourcemap=none --outfile=dist/askvid.js && chmod +x dist/askvid.js",
    "check": "node node_modules/typescript/bin/tsc -b tsconfig.json",
    "lint": "node node_modules/oxlint/bin/oxlint .",
    "format": "node node_modules/oxfmt/bin/oxfmt --write .",
    "format:check": "node node_modules/oxfmt/bin/oxfmt --check .",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run lint && bun run format:check && bun run test && bun run build",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node node_modules/vitest/vitest.mjs run test/e2e"
  },
  "dependencies": {
    "@effect/ai-openrouter": "4.0.0-beta.74",
    "@effect/platform-node": "4.0.0-beta.74",
    "@effect/platform-node-shared": "4.0.0-beta.74",
    "effect": "4.0.0-beta.74"
  },
  "devDependencies": {
    "@effect/language-service": "0.86.2",
    "@types/node": "25.7.0",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "typescript": "7.0.1-rc",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
